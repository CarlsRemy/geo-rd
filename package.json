{
  "name": "geo-rd",
  "version": "2.0.0",
  "description": "Librería ligera para trabajar con las divisiones geográficas de la República Dominicana (provincias y municipios).",
  "main": "dist/geo-rd.cjs",
  "module": "dist/geo-rd.mjs",
  "types": "dist/geo-rd.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/geo-rd.mjs",
      "require": "./dist/geo-rd.cjs"
    },
    "./provincias": {
      "import": "./dist/provincias.mjs",
      "require": "./dist/provincias.cjs"
    },
    "./municipios": {
      "import": "./dist/municipios.mjs",
      "require": "./dist/municipios.cjs"
    },
    "./distritos": {
      "import": "./dist/distritos.mjs",
      "require": "./dist/distritos.cjs"
    }
  },
  "scripts": {
    "tsup": "tsup src/geo-rd.ts src/provincias.ts src/municipios.ts src/distritos.ts --dts --format esm,cjs --minify --out-dir dist",
    "build": "npm run tsup",
    "test": "ts-mocha test/*"
  },
  "keywords": [
    "one-rd",
    "geographic-demarcations",
    "territorial-division",
    "provinces-RD",
    "dominican-republic",
    "dominican-developers",
    "backend"
  ],
  "author": "Carlos Ismael .Y .R",
  
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.5.8",
    "chai": "^4.3.8",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2"
  }
}